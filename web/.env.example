# Copy to .env.local for development, and set the same keys in your host's
# environment settings (Vercel → Settings → Environment Variables, or
# Netlify → Site configuration → Environment variables).

# --- Booking IDs and storage (required in production) -----------------------
# Upstash Redis, REST API. Create a database at https://console.upstash.com
# and copy these two values from its "REST API" tab.
# Without them the app falls back to an in-process store: fine for `npm run dev`,
# NOT safe in production — booking numbers would only be unique per instance.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Google Sheets mirror (optional, but this is the team's live view) -------
# 1. Google Cloud console → create a project → enable the "Google Sheets API".
# 2. Create a Service Account, then add a JSON key for it.
# 3. From that JSON: client_email → GOOGLE_SERVICE_ACCOUNT_EMAIL,
#                    private_key  → GOOGLE_PRIVATE_KEY.
# 4. Open your Google Sheet → Share → give that client_email Editor access.
#    (This step is the one people forget; without it every write returns 403.)
# 5. GOOGLE_SHEET_ID is the long id in the sheet's URL:
#    docs.google.com/spreadsheets/d/<THIS PART>/edit
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Keep the surrounding quotes — the key contains newlines written as \n.
GOOGLE_PRIVATE_KEY=""
GOOGLE_SHEET_ID=
# Tab name to append to. Defaults to "Bookings" if unset.
GOOGLE_SHEET_TAB=Bookings

# --- Operator endpoint ------------------------------------------------------
# Any long random string. Guards /api/admin/sheets (header row + Sheets replay).
# Generate one with:  openssl rand -hex 32
ADMIN_TOKEN=
